# Britt's OS — environment variables (PRD §10)
# Copy to .env.local and fill in. Without Supabase vars the app runs in DEMO MODE
# with sample data so the dashboard is reviewable immediately.

# Force demo data even when Supabase is set (optional)
# DEMO_MODE=1

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=          # server only, never in a client component

# --- Follow Up Boss (P0) ---
FUB_API_KEY=
FUB_WEBHOOK_SECRET=
FUB_SYSTEM_NAME=BrittsOS
FUB_SYSTEM_KEY=

# --- MLS / IDX (P0) ---
MLS_CLIENT_ID=
MLS_CLIENT_SECRET=
MLS_TOKEN_URL=
MLS_API_BASE=
MLS_AGENT_ID=                       # your MLS id, for filtering own listings

# --- Messaging ---
RESEND_API_KEY=
NOTIFY_FROM_EMAIL=os@brittdowling.com
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
NOTIFY_TO_PHONE=
NOTIFY_TO_EMAIL=

# --- Calendars ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALENDAR_ID=
CALENDLY_TOKEN=
CALENDLY_WEBHOOK_SECRET=

# --- ESP ---
MAILCHIMP_API_KEY=
MAILCHIMP_SERVER_PREFIX=
MAILCHIMP_AUDIENCE_ID=

# --- App ---
NEXT_PUBLIC_APP_URL=https://os.brittdowling.com
CRON_SECRET=
SENTRY_DSN=
TZ=America/Chicago
